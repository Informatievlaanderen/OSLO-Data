{
  "@context": {
    "@base": "https://data.vlaanderen.be/id/changeevents/adres/",
    "dcterms": "http://purl.org/dc/terms/",
    "content": "http://www.w3.org/2011/content#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "generiek": "https://data.vlaanderen.be/ns/generiek#",
    "sf": "http://www.opengis.net/ont/sf#",
    "geosparql": "http://www.opengis.net/ont/geosparql#",
    "locn": "http://www.w3.org/ns/locn#",
    "adres": "https://data.vlaanderen.be/ns/adres#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "as": "http://www.w3.org/ns/activitystreams#",
    "id": "@id",
    "time": { "@id": "dcterms:issued", "@type": "xsd:date" },
    "type": { "@id": "dcterms:type", "@type": "@vocab" },
    "source": "dcterms:source",
    "datacontenttype": "dcterms:format",
    "subject": "dcterms:subject",
    "objectId": "generiek:lokaleIdentificator",
    "naamruimte": "generiek:naamruimte",
    "versieId": "generiek:versieIdentificator",
    "data": "rdf:value",
    "dataschema": "dcterms:conformsTo",
    "basisregisterseventtype": { "@id": "rdf:type", "@type": "@id", "@context": {"@base": "https://implementatie.data.vlaanderen.be/ns/grar/changefeeds/"} },
    "basisregisterscausationid": "dcterms:identifier",
    "nisCodes": { "@id": "adres:heeftGemeente", "@type": "@id", "@context": {"@base": "https://data.vlaanderen.be/id/gemeente/"} },
    "attributen": "basisregisters:attributen",
    "naam": {
      "@id": "rdf:predicate",
      "@type": "@vocab"
    },
    "oudeWaarde": null,
    "nieuweWaarde": "rdf:object",
    "Punt": "sf:Point",
    "gml": "geosparql:asGML",
    "wkt": "geosparql:asWKT",
    "positie.geometrie": "locn:geometry",
    "positie.methode": "generiek:methode",
    "positie.specificatie": "generiek:specificatie",
    "officieelToegekend": "adres:officieelToegekend",
    "status": "adres:status",
    "huisnummer": "adres:huisnummer",
    "busnummer": "adres:busnummer",
    "heeftStraatnaam": "adres:heeftStraatnaam",
    "heeftGemeentenaam": "adres:heeftGemeentenaam",
    "heeftPostinfo": "adres:heeftPostinfo",
    "basisregisters.address.create.v1": "as:Create",
    "basisregisters.address.update.v1": "as:Update",
    "basisregisters.address.delete.v1": "as:Delete",
    "specversion": {"@id": "dcterms:conformsTo", "@type": "@id", "@context": {"@base": "https://github.com/cloudevents/spec/tree/" }}
  }
}
