@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.com/ns#> .
@prefix fixme: <http://fixme.com#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix mobivoc: <http://schema.mobivoc.org/#> .
@prefix openbaardomein: <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/fietsstallingszone/id/2> a mobivoc:BicycleParkingStation, openbaardomein:Fietsstalling,
    openbaardomein:FysiekObject, openbaardomein:Infrastructuurelement;
  fixme:eigenaar <https://example.com/fietsstallingszone/id/2#eigenaar>;
  dcterms:type <https://example.com/id/concept/deelgemeentetype/Centrum>, <https://example.com/id/concept/sectortype/Centrum>,
    <https://example.com/id/concept/sitetype/wegzone>;
  adms:indentifier <https://example.com/fietsstallingszone/id/2#identificator>;
  locn:address <https://example.com/fietstalling/id/2#adres>;
  locn:geometry <https://example.com/fietsstallingszone/id/2#geometrie>;
  openbaardomein:afsluitbaar false;
  openbaardomein:beheerder <https://example.com/fietsstallingszone/id/2#beheerder>;
  openbaardomein:capaciteit 10;
  openbaardomein:fietsdelen false;
  openbaardomein:materiaal <https://example.com/id/concept/ondergrondtype#kassei>;
  openbaardomein:overdekt false;
  openbaardomein:verplaatsbaar false .

<http://example.com/fietsstallingszone/id/2#geometrie> a geosparql:Geometry;
  geosparql:asGeoJSON "{type=MultiPolygon, coordinates=[[[[3.2287947848, 51.2095114252], [3.2288075632, 51.2094979567], [3.2289398452, 51.2095431718], [3.2289264468, 51.2095577514], [3.2287947848, 51.2095114252]]]]}"^^geosparql:geoJSONLiteral .

<https://example.com/fietsstallingszone/id/2#beheerder> a org:Organization;
  skos:prefLabel "stad Brugge"@nl .

<https://example.com/fietsstallingszone/id/2#eigenaar> a org:Organization;
  skos:prefLabel "stad Brugge"@nl .

<https://example.com/fietsstallingszone/id/2#identificator> a adms:Identifier;
  skos:notation "2" .

<https://example.com/fietstalling/id/2#adres> a locn:Address;
  locn:fullAddress "Hoogstraat"@nl .

<https://example.com/id/concept/deelgemeentetype/Centrum> a skos:Concept .

<https://example.com/id/concept/sectortype/Centrum> a skos:Concept .

<https://example.com/id/concept/sitetype/wegzone> a skos:Concept .
