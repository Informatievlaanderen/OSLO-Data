{
  "title": "Persoon",
  "type": "object",
  "description": "Natuurlijk persoon.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse Persoon)",
      "pattern": "^Persoon$"
    },
    "voornaam": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 0
    },
    "achternaam": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie. Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 0
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geslacht": {
      "$ref": "#/components/schemas/Geslacht"
    },
    "isHoofdVan": {
      "$ref": "#/components/schemas/Gezin"
    },
    "heeftBurgerlijkeStaat": {
      "$ref": "#/components/schemas/BurgerlijkeStaat"
    },
    "heeftGeboorte": {
      "$ref": "#/components/schemas/Geboorte"
    },
    "heeftOverlijden": {
      "$ref": "#/components/schemas/Overlijden"
    },
    "heeftInwonerschap": {
      "$ref": "#/components/schemas/Inwonerschap"
    },
    "heeftPersoonsrelatie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Persoonsrelatie"
        },
        {
          "$ref": "#/components/schemas/Gezinsrelatie"
        },
        {
          "$ref": "#/components/schemas/Huwelijk"
        },
        {
          "$ref": "#/components/schemas/Samenwonen"
        },
        {
          "$ref": "#/components/schemas/Afstamming"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Persoonsrelatie": "#/components/schemas/Persoonsrelatie",
          "Gezinsrelatie": "#/components/schemas/Gezinsrelatie",
          "Huwelijk": "#/components/schemas/Huwelijk",
          "Samenwonen": "#/components/schemas/Samenwonen",
          "Afstamming": "#/components/schemas/Afstamming"
        }
      }
    },
    "isLidVan": {
      "type": "array",
      "description": "Lijst van Gezin items.",
      "items": {
        "$ref": "#/components/schemas/Gezin"
      },
      "minItems": 0
    },
    "creatiedatum": {
      "type": "object",
      "description": "Datum waarop de gegevens zijn ingevoerd.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "modificatiedatum": {
      "type": "object",
      "description": "Datum waarop de gegevens werden bijgewerkt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "bron": {
      "$ref": "#/components/schemas/Organisatie"
    },
    "@context": {
      "type": "string",
      "format": "uri",
      "pattern": "^https:\\/\\/test.data.vlaanderen.be\\/doc\\/implementatiemodel\\/magda\\/persoon\\/context\\/persoon-IM.jsonld$"
    }
  },
  "required": [
    "@id",
    "@type",
    "heeftInwonerschap",
    "heeftPersoonsrelatie",
    "creatiedatum",
    "bron",
    "@context"
  ]
}