{
  "title": "Afstamming",
  "type": "object",
  "description": "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties.",
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri",
      "enum": [
        "http://example.org/context.jsonld"
      ]
    },
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "array",
      "description": "Lijst van object types (klasse)",
      "items": {
        "type": "string",
        "description": "Afstamming type"
      },
      "minItems": 1
    },
    "Afstamming.datumVanAfstamming": {
      "type": "object",
      "description": "De datum waarop de afstamming wordt vastgesteld.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "enum": [
            "DateTime"
          ]
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "Afstamming.afstammingstype": {
      "type": "object",
      "description": "Aard van de afstamming. Bijvoorbeeld: geadopteerd, kind uit huwelijk, erkend door de vader, etc.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    },
    "Afstamming.vanPersoon": {
      "type": "object",
      "description": "Persoon die een persoonsrelatie heeft.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    },
    "Afstamming.metPersoon": {
      "type": "object",
      "description": "De persoon waarmee de persoon een relatie heeft.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "Afstamming.datumVanAfstamming",
    "Afstamming.afstammingstype",
    "Afstamming.vanPersoon",
    "Afstamming.metPersoon"
  ]
}