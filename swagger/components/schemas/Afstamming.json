{
  "title": "Afstamming",
  "type": "object",
  "description": "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse Afstamming)",
      "pattern": "^Afstamming$"
    },
    "datumVanAfstamming": {
      "type": "object",
      "description": "De datum waarop de afstamming wordt vastgesteld.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "afstammingstype": {
      "$ref": "#/components/schemas/Afstammingstype"
    },
    "vanPersoon": {
      "$ref": "#/components/schemas/Persoon"
    },
    "metPersoon": {
      "$ref": "#/components/schemas/Persoon"
    }
  },
  "required": [
    "@id",
    "@type",
    "vanPersoon",
    "metPersoon"
  ]
}