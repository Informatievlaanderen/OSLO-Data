{
  "title": "GeregistreerdeOrganisatie",
  "type": "object",
  "description": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse GeregistreerdeOrganisatie)",
      "pattern": "^GeregistreerdeOrganisatie$"
    },
    "GeregistreerdeOrganisatie.wettelijkeNaam": {
      "type": "object",
      "description": "Wettelijk geregistreerde naam vd organisatie. Evt in verschillende talen.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "GeregistreerdeOrganisatie.registratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "Organisatie.voorkeursnaam": {
      "type": "object",
      "description": "Naam waarmee de Organisatie bij voorkeur wordt aangeduid.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "contactinfo": {
      "type": "array",
      "description": "Lijst van Contactinfo items.",
      "items": {
        "$ref": "#/components/schemas/Contactinfo"
      },
      "minItems": 0
    }
  },
  "required": [
    "@id",
    "@type"
  ]
}