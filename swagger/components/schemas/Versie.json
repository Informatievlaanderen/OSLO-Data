{
  "title": "Versie",
  "type": "object",
  "description": "Entiteit gedurende een bepaalde periode in de databank.",
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri",
      "enum": [
        "http://example.org/context.jsonld"
      ]
    },
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "array",
      "description": "Lijst van object types (klasse)",
      "items": {
        "type": "string",
        "description": "Versie type"
      },
      "minItems": 1
    },
    "Versie.tijdstipCreatie": {
      "type": "object",
      "description": "Tijdstip waarop de gegevens zijn ingevoerd.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "enum": [
            "DateTime"
          ]
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "Versie.tijdstipModificatie": {
      "type": "object",
      "description": "Tijdstip waarop de gegevens werden bijgewerkt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "enum": [
            "DateTime"
          ]
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "Versie.bron": {
      "type": "object",
      "description": "Verantwoordelijke voor het aanmaken van de gegevens.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            },
            {
              "$ref": "https://raw.githubusercontent.com/Informatievlaanderen/OSLO-Data/refs/heads/main/swagger/components/schemas/Organisatie.json"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "Versie.tijdstipCreatie",
    "Versie.bron"
  ]
}