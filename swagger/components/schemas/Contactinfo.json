{
  "title": "Contactinfo",
  "type": "object",
  "description": "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse Contactinfo)",
      "pattern": "^Contactinfo$"
    },
    "Contactinfo.aanschrijfvorm": {
      "type": "object",
      "description": "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen. Bijvoorbeeld: De heer/Mevrouw, Excellentie, Dokter, ...",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "Contactinfo.naam": {
      "type": "object",
      "description": "Naam van bijvoorbeeld de persoon die men kan contacteren.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "Contactinfo.email": {
      "type": "object",
      "description": "Email-adres waarnaar men kan mailen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "Contactinfo.faxnummer": {
      "type": "object",
      "description": "Faxnummer waarnaar men kan faxen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "Contactinfo.telefoon": {
      "type": "object",
      "description": "Telefoonnummer waarop men kan bellen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "Contactinfo.website": {
      "type": "object",
      "description": "Website waarnaar men kan surfen.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "Contactinfo.adres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    }
  },
  "required": [
    "@id",
    "@type"
  ]
}