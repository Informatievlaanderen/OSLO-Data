{
  "title": "Overlijden",
  "type": "object",
  "description": "Het doodgaan van een Persoon.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse Overlijden)",
      "pattern": "^Overlijden$"
    },
    "Persoonsgebeurtenis.datum": {
      "type": "object",
      "description": "Datum waarop de gebeurtenis plaatsvond.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "Persoonsgebeurtenis.plaats": {
      "$ref": "#/components/schemas/Plaats"
    }
  },
  "required": [
    "@id",
    "@type"
  ]
}