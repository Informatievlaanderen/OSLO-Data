{
  "title": "Registratie",
  "type": "object",
  "description": "Opname van de Persoon in het register.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse Registratie)",
      "pattern": "^Registratie$"
    },
    "dossierstatus": {
      "type": "array",
      "description": "Lijst van Dossierstatustype items.",
      "items": {
        "$ref": "#/components/schemas/Dossierstatustype"
      },
      "minItems": 0
    },
    "geregistreerdPersoon": {
      "$ref": "#/components/schemas/GeregistreerdPersoon"
    },
    "vorigeRegistratie": {
      "$ref": "#/components/schemas/Registratie"
    },
    "volgendeRegistratie": {
      "$ref": "#/components/schemas/Registratie"
    }
  },
  "required": [
    "@id",
    "@type",
    "geregistreerdPersoon"
  ]
}