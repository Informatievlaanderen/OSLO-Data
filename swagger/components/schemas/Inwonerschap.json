{
  "title": "Inwonerschap",
  "type": "object",
  "description": "Het feit dat een Persoon verblijf houdt in een plaats of land.",
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri",
      "enum": [
        "http://example.org/context.jsonld"
      ]
    },
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "array",
      "description": "Lijst van object types (klasse)",
      "items": {
        "type": "string",
        "description": "Inwonerschap type"
      },
      "minItems": 1
    },
    "Inwonerschap.persoon": {
      "type": "object",
      "description": "De persoon waarvan het inwonerschap binnen de opgegeven Jurisdictie valt.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            },
            {
              "$ref": "https://raw.githubusercontent.com/Informatievlaanderen/OSLO-Data/refs/heads/main/swagger/components/schemas/Persoon.json"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    },
    "Inwonerschap.jurisdictie": {
      "type": "object",
      "description": "Jurisdictie waarbinnen het inwonerschap (van een persoon) is gedefineerd.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            },
            {
              "$ref": "https://raw.githubusercontent.com/Informatievlaanderen/OSLO-Data/refs/heads/main/swagger/components/schemas/Jurisdictie.json"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    },
    "Inwonerschap.heeftVerblijfplaats": {
      "type": "array",
      "description": "Lijst van Verblijfplaats items.",
      "items": {
        "type": "object",
        "description": "Plaats waar een persoon verblijft.",
        "properties": {
          "@id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "format": "blanknode"
              },
              {
                "$ref": "https://raw.githubusercontent.com/Informatievlaanderen/OSLO-Data/refs/heads/main/swagger/components/schemas/Verblijfplaats.json"
              }
            ]
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "Inwonerschap.persoon",
    "Inwonerschap.jurisdictie"
  ]
}