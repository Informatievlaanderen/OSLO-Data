{
  "title": "Registratie",
  "type": "object",
  "description": "Opname van de Persoon in het register.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "object",
      "description": "Object type (klasse Registratie)",
      "pattern": "^Registratie$"
    },
    "Registratie.dossierstatus": {
      "type": "array",
      "description": "Lijst van Dossierstatustype items.",
      "items": {
        "$ref": "#/components/schemas/Dossierstatustype"
      },
      "minItems": 0
    },
    "Registratie.geregistreerdPersoon": {
      "$ref": "#/components/schemas/GeregistreerdPersoon"
    },
    "Registratie.vorigeRegistratie": {
      "$ref": "#/components/schemas/Registratie"
    },
    "Registratie.volgendeRegistratie": {
      "$ref": "#/components/schemas/Registratie"
    },
    "@context": {
      "type": "string",
      "format": "uri",
      "pattern": "^https:\\/\\/test.data.vlaanderen.be\\/doc\\/implementatiemodel\\/magda\\/persoon\\/context\\/persoon-IM.jsonld$"
    }
  },
  "required": [
    "@id",
    "@type",
    "Registratie.geregistreerdPersoon",
    "@context"
  ]
}