{
  "title": "Jurisdictie",
  "type": "object",
  "description": "Het gebied waarover de rechtsmacht van een overheid zich uitstrekt.",
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri",
      "enum": [
        "http://example.org/context.jsonld"
      ]
    },
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "array",
      "description": "Lijst van object types (klasse)",
      "items": {
        "type": "string",
        "description": "Jurisdictie type"
      },
      "minItems": 1
    },
    "Jurisdictie.plaats": {
      "type": "object",
      "description": "Ruimtelijk gebied of benoemde plaats waarmee de Jurisdictie samenvalt. Typisch een land.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "format": "blanknode"
            }
          ]
        }
      },
      "required": [
        "@id"
      ]
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "Jurisdictie.plaats"
  ]
}